#include<iostream>
#include<unordered_map>
using namespace std;

int main()
{
   unordered_map<char,char>R;
   unordered_map<char,char>L;
   string s = "qwertyuiopasdfghjkl;zxcvbnm,./";
   for(int i = 1; i<s.length();i++){
    R[s[i]] = s[i-1];
    L[s[i-1]] = s[i];
    // cout<<s[i]<<endl;
   }
   char dir;
   cin>>dir;
   string str;
   cin>>str;
   if(dir == 'R'){
        for(int i = 0; i<str.length();i++){
            str[i] = R[str[i]];
        }
   }
   else if(dir == 'L'){
    for(int i = 0; i<str.length();i++){
            str[i] = L[str[i]];
        }
   }
   cout<<str<<endl;
    return 0;
}
