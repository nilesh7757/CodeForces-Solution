#include<bits/stdc++.h>
using namespace std;
void solve(){
    int n;
    cin>>n;
    string s;
    cin>>s;
    int cntC =0;
    int cntD = 0;
    for(int i = 0; i<n; i++){
        if(s[i] == '('){
            cntC++;
        }
        else{
            if(cntC == 0){
                cntD++;
            }
            else{
                cntC--;
            }
        }
    }
    cout<<cntC<<endl;
    return;
}
int main()
{
    int t;
    cin>>t;
    while(t--){
        solve();
    }
}
